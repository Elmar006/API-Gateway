# ─── docker-compose / API Gateway shared environment ────────────────────
# Copy to `.env` at the repo root and adjust values.
# All variables are consumed by `docker-compose.yml`.

# ── Required: gateway secrets ───────────────────────────────────────────
JWT_SECRET=change-me-please-32+characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-pass-change-me

# ── Public proxy / admin API ────────────────────────────────────────────
PORT=8080
ADMIN_PORT=9090
PORT_HOST=8080
ADMIN_PORT_HOST=9090

LOG_LEVEL=info
LOG_FORMAT=text
MAX_BODY_BYTES=10485760
RATE_LIMIT_TTL=5m
LOG_BUFFER_SIZE=4096
LOG_BATCH_SIZE=200
LOG_FLUSH_PERIOD=500ms

TLS_ENABLED=false
CERT_FILE=
KEY_FILE=

# ── PostgreSQL ──────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_MIN=30
DB_PORT_HOST=5432

# ── Client (Vite web build behind nginx) ────────────────────────────────
CLIENT_PORT_HOST=8000
# Base URL used by the SPA when calling the admin API. Default routes
# requests through nginx → backend service inside the docker network.
VITE_API_BASE_URL=/admin
