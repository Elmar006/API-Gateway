# ─── Application ────────────────────────────────────────────────
PORT=8080
ADMIN_PORT=9090
LOG_LEVEL=info
LOG_FORMAT=text

# Required: 16+ chars secret used to sign admin and user JWTs
JWT_SECRET=change-me-please-32+characters

# Bootstrap admin (created on first start when admin_users is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-pass-change-me

# Public proxy hardening
MAX_BODY_BYTES=10485760
RATE_LIMIT_TTL=5m

# Async logger (ring buffer + pgx.CopyFrom batches)
LOG_BUFFER_SIZE=4096
LOG_BATCH_SIZE=200
LOG_FLUSH_PERIOD=500ms

# TLS (optional; both files must be readable when TLS_ENABLED=true)
TLS_ENABLED=false
CERT_FILE=
KEY_FILE=

# ─── PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_MIN=30
