{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RouteFlow",
  "version": "0.1.0",
  "identifier": "com.routeflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RouteFlow",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0B0820"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop control plane for API gateway routing",
    "longDescription": "RouteFlow is a desktop-first control plane that lets engineers visualise and manage API gateway routes, services, and policies.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
